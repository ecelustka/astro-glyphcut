{
  "name": "astro-glyphcut",
  "version": "0.0.0",
  "private": true,
  "description": "Astro 7 font provider that subsets fonts at build time",
  "keywords": [
    "astro",
    "astro-integration",
    "fonts",
    "fontsource",
    "subset",
    "woff2"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecelustka/astro-glyphcut.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "test": "vitest run",
    "check:package": "pnpm build && publint && attw --pack --profile esm-only",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm knip && pnpm test && pnpm check:package"
  },
  "dependencies": {
    "fontverter": "^2.0.0",
    "harfbuzzjs": "^1.6.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/node": "^22.20.5",
    "astro": "^7.4.12",
    "knip": "^6.45.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.5.1"
}
