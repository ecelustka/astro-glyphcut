{
  "name": "astro-glyphcut",
  "version": "0.3.0",
  "description": "Astro 7 font provider that subsets fonts at build time",
  "keywords": [
    "astro",
    "astro-integration",
    "fonts",
    "fontsource",
    "subset",
    "woff2"
  ],
  "homepage": "https://github.com/ecelustka/astro-glyphcut#readme",
  "bugs": {
    "url": "https://github.com/ecelustka/astro-glyphcut/issues"
  },
  "license": "MIT",
  "author": "Emil Celustka",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecelustka/astro-glyphcut.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "test": "vitest run",
    "test:types": "tsc -p test/fixtures/consumer && pnpm dlx --package typescript@6 tsc -p test/fixtures/consumer",
    "check:package": "pnpm build && publint && attw --pack --profile esm-only",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm knip && pnpm check:package && pnpm test",
    "release": "pnpm build && changeset publish"
  },
  "dependencies": {
    "fontverter": "^2.0.0",
    "harfbuzzjs": "^1.6.1",
    "parse5": "^8.1.1",
    "subset-font": "^2.9.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/node": "^22.20.5",
    "astro": "^7.4.13",
    "knip": "^6.46.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "astro": "^6.0.0 || ^7.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.21.0"
}
